{
  "schemaVersion": 1,
  "id": "mining_and_placing_animations",
  "version": "${version}",
  "name": "Mining & Placing Animations",
  "description": "Adds customizable animations to blocks when mining and placing! (Mining Quakes successor)",
  "authors": [
    "Gaura"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/mining_and_placing_animations",
    "sources": "https://github.com/Gauraaaaaaaa/MiningAndPlacingAnimations",
    "issues": "https://github.com/Gauraaaaaaaa/MiningAndPlacingAnimations/issues"
  },
  "license": "GPL-3.0",
  "icon": "assets/mining_and_placing_animations/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.gaura.mining_and_placing_animations.fabric.MiningAndPlacingAnimationsFabric"
    ]
  },
  "mixins": [
    "mining_and_placing_animations.mixins.json",
    "mining_and_placing_animations_fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "~1.21.11",
