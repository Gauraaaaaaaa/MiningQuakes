{
  "global": {
    "mining_animation": "mining_and_placing_animations:animations/default_mining_animation",
    "placing_animation": "mining_and_placing_animations:animations/default_placing_animation"
  },
  "specific": [
    {
      "blocks": [
        "#minecraft:slabs"
      ],
      "mining_animation": "mining_and_placing_animations:animations/slab_mining_animation",
      "placing_animation": "mining_and_placing_animations:animations/slab_placing_animation"
    },
    {
      "blocks": [
        "#minecraft:banners"
      ],
      "mining_animation": "mining_and_placing_animations:animations/banner_mining_animation",
      "placing_animation": "mining_and_placing_animations:animations/banner_placing_animation"
    }
  ],
  "mining_blacklist": [
    "minecraft:chest",
    "minecraft:trapped_chest",
    "#minecraft:copper_chests",
    "#minecraft:beds",
    "#minecraft:doors",
    "#minecraft:flowers",
    "#minecraft:crops",
    "#minecraft:saplings"
  ],
  "placing_blacklist": [
    "minecraft:chest",
    "minecraft:trapped_chest",
    "#minecraft:copper_chests",
    "#minecraft:beds",
    "#minecraft:doors"
  ]
}